# Supabase → Project Settings → Database → Connection string → URI
# (используйте "Connection pooling" / Transaction mode, порт 6543, для Railway)
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Сгенерируйте случайную строку, например: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=60

# Домен фронтенда (для CORS), через запятую если их несколько
CORS_ORIGINS=https://your-frontend.up.railway.app,http://localhost:5173

# Email-уведомления о новых задачах на согласование (необязательно —
# без этих переменных уведомления просто не отправляются, приложение работает как обычно)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=edo@your-company.ru
APP_BASE_URL=https://your-frontend.up.railway.app
